{
  "name": "Fish reference voice synthesis with bounded polling",
  "nodes": [
    {
      "id": "start",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {}
    },
    {
      "id": "setup-notes",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, -300],
      "parameters": {
        "content": "## Fish Audio through AceDataCloud\nInstall @acedatacloud/n8n-nodes-fish. Select your API credential on Create and Get Task. Each input item creates one paid task. The loop queries that same ID and stops after 30 minutes; it never resubmits generation.",
        "height": 230,
        "width": 540
      }
    },
    {
      "id": "create",
      "name": "Create",
      "type": "@acedatacloud/n8n-nodes-fish.fish",
      "typeVersion": 1,
      "position": [220, 0],
      "parameters": {
        "resource": "audio",
        "operation": "create",
        "text": "Welcome. Your automation is ready. Let us turn useful ideas into results.",
        "model": "s2-pro",
        "format": "mp3",
        "voiceSource": "reference",
        "simplify": true,
        "referenceAudioUrl": "https://cdn.acedata.cloud/assets/examples/fish/6220d605-39d0-4d43-9e58-0f12949dc9b9-570cfdf96ad9.mp3",
        "referenceText": "\u6625\u5929\u7684\u6e05\u6668\uff0c\u9633\u5149\u7a7f\u8fc7\u6811\u53f6\uff0c\u843d\u5728\u5b89\u9759\u7684\u5c0f\u8def\u4e0a\u3002"
      },
      "retryOnFail": false
    },
    {
      "id": "initialize",
      "name": "Initialize",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 0],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "taskId",
              "name": "taskId",
              "value": "={{ $json.taskId }}",
              "type": "string"
            },
            {
              "id": "deadline",
              "name": "deadline",
              "value": "={{ $now.plus({ minutes: 30 }).toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "wait-15-seconds",
      "name": "Wait 15 Seconds",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [660, 0],
      "parameters": {
        "resume": "timeInterval",
        "amount": 15,
        "unit": "seconds"
      },
      "webhookId": "fish-generation-wait"
    },
    {
      "id": "get-task",
      "name": "Get Task",
      "type": "@acedatacloud/n8n-nodes-fish.fish",
      "typeVersion": 1,
      "position": [880, 0],
      "parameters": {
        "resource": "task",
        "operation": "get",
        "taskId": "={{ $('Initialize').first().json.taskId }}",
        "simplify": true
      }
    },
    {
      "id": "finished",
      "name": "Finished",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1100, 0],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check",
              "leftValue": "={{ $json.finished }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "succeeded",
      "name": "Succeeded",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1320, -100],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check",
              "leftValue": "={{ $json.successful === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "deadline-reached",
      "name": "Deadline Reached",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1320, 180],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check",
              "leftValue": "={{ $now.toMillis() >= Date.parse($('Initialize').first().json.deadline) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "result",
      "name": "Result",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1540, -180],
      "parameters": {}
    },
    {
      "id": "generation-failed",
      "name": "Generation Failed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [1540, -20],
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "={{ \"Generation failed for task \" + $json.taskId + \": \" + JSON.stringify($json.error) }}"
      }
    },
    {
      "id": "stop-waiting",
      "name": "Stop Waiting",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [1540, 180],
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "={{ 'Stopped waiting after 30 minutes. Query task ' + $('Initialize').first().json.taskId + ' again later; do not resubmit Create.' }}"
      }
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Create",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create": {
      "main": [
        [
          {
            "node": "Initialize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Initialize": {
      "main": [
        [
          {
            "node": "Wait 15 Seconds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 15 Seconds": {
      "main": [
        [
          {
            "node": "Get Task",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Task": {
      "main": [
        [
          {
            "node": "Finished",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Finished": {
      "main": [
        [
          {
            "node": "Succeeded",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Deadline Reached",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Succeeded": {
      "main": [
        [
          {
            "node": "Result",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Generation Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Deadline Reached": {
      "main": [
        [
          {
            "node": "Stop Waiting",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait 15 Seconds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 1900
  },
  "active": false,
  "tags": []
}
